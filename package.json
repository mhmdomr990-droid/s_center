{
  "name": "student-bot-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/copy-panel-assets.mjs && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-panel-assets.mjs",
    "start": "node dist/server.js",
    "seed:admin": "npm run build && node dist/seed-admin.js",
    "copy:panel-assets": "node scripts/copy-panel-assets.mjs",
    "test:smoke": "ts-node scripts/smoke-test.ts",
    "postinstall": "node scripts/copy-panel-assets.mjs"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "chart.js": "^4.4.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
