<%- include('../layout/header', { title: 'كورساتي' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar">
  <div>
    <h1 style="margin:0;">كورساتي</h1>
  </div>
</div>
<%- include('../partials/breadcrumb', {
  items: [
    { label: 'لوحة المعلّم', href: '/panel/teacher/courses' },
    { label: 'مقرراتي' },
  ],
}) %>
<div class="panel-table">
  <table>
    <thead>
      <tr>
        <th>الاسم</th>
        <th>المشتريات</th>
        <th>الأرباح</th>
        <th>السعر</th>
        <th>الحالة</th>
        <th>المحاضرات</th>
      </tr>
    </thead>
    <tbody>
      <% if (!courses.length) { %>
        <tr>
          <td colspan="6">
            <section class="polish-empty">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 5h16v2H4zm0 6h16v2H4zm0 6h10v2H4z"/></svg>
              <h4>لا توجد مواد مسندة لك حاليًا</h4>
              <p>عند إسناد كورس جديد لك من الإدارة سيظهر هنا مباشرة.</p>
            </section>
          </td>
        </tr>
      <% } %>
      <% courses.forEach((item) => { %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.purchases_count %></td>
          <td><%= money(item.earned) %></td>
          <td><%= money(item.price) %></td>
          <td><%= item.is_published ? 'منشور' : 'مخفي' %></td>
          <td><a class="panel-btn panel-btn-secondary" href="/panel/teacher/lectures?courseId=<%= item.course_id %>">إدارة المحاضرات</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../layout/footer') %>
