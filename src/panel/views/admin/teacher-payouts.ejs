<%- include('../layout/header', { title: 'سجل دفعات المدرس' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken, pendingTopupsCount }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar">
  <div>
    <h1 style="margin:0;">سجل دفعات المدرس</h1>
    <p class="panel-muted" style="margin:6px 0 0;"><%= teacher.full_name %></p>
  </div>
</div>
<%- include('../partials/breadcrumb', {
  items: [
    { label: 'لوحة التحكم', href: '/panel/admin/overview' },
    { label: 'المعلّمون', href: '/panel/admin/teachers' },
    { label: teacher.full_name },
    { label: 'سجل الدفعات' },
  ],
}) %>
<div class="panel-card" style="margin-bottom:16px;">
  <div class="panel-grid-3">
    <div><span class="panel-muted">المستحق</span><strong><%= money(summary.earned) %></strong></div>
    <div><span class="panel-muted">المدفوع</span><strong><%= money(summary.paid) %></strong></div>
    <div><span class="panel-muted">المتبقي</span><strong><%= money(summary.remaining) %></strong></div>
  </div>
</div>
<div class="panel-form" style="margin-bottom:16px;">
  <h3 style="margin-top:0;">إضافة دفعة جديدة</h3>
  <p class="panel-muted" style="margin-top:0;">يمكن إدخال المبلغ بأرقام عربية أو إنجليزية.</p>
  <form method="post" action="/panel/admin/teachers/<%= teacher.teacher_id %>/payouts" class="panel-form" style="box-shadow:none;border:0;padding:0;">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <div class="panel-form-grid">
      <div>
        <label>المبلغ</label>
        <input name="amount" type="text" required placeholder="220.00">
      </div>
      <div>
        <label>ملاحظة</label>
        <input name="note" type="text" placeholder="دفعة شهرية">
      </div>
    </div>
    <div class="panel-form-actions">
      <button class="panel-btn panel-btn-primary" type="submit">حفظ الدفعة</button>
    </div>
  </form>
</div>
<div class="panel-table">
  <table>
    <thead>
      <tr><th>المبلغ</th><th>ملاحظة</th><th>أنشئ بواسطة</th><th>التاريخ</th></tr>
    </thead>
    <tbody>
      <% if (!payouts.length) { %>
        <tr>
          <td colspan="4">
            <section class="polish-empty">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 6h18v12H3V6zm2 2v8h14V8H5zm3 2h8v2H8v-2z"/></svg>
              <h4>لا توجد دفعات مسجلة لهذا المدرس</h4>
              <p>أضف دفعة جديدة وسيظهر سجلها هنا.</p>
            </section>
          </td>
        </tr>
      <% } %>
      <% payouts.forEach((item) => { %>
        <tr>
          <td><%= money(item.amount) %></td>
          <td><%= item.note || '-' %></td>
          <td><%= item.created_by %></td>
          <td><%= date(item.created_at) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../layout/footer') %>
