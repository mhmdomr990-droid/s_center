<%- include('../layout/header', { title: 'الكورسات' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken, pendingTopupsCount }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar">
  <div>
    <h1 style="margin:0;">الكورسات</h1>
    <p class="panel-muted" style="margin:6px 0 0;">إدارة الكورسات والمدرسين والنسب</p>
  </div>
  <button class="panel-btn panel-btn-primary" data-modal-open="course-create-modal">إضافة كورس</button>
</div>
<%- include('../partials/breadcrumb', {
  items: [
    { label: 'لوحة التحكم', href: '/panel/admin/overview' },
    { label: 'المقررات' },
  ],
}) %>
<div class="panel-toolbar">
  <form method="get" action="/panel/admin/courses">
    <input type="text" name="specializationId" placeholder="التخصص" value="<%= filters.specializationId || '' %>">
    <input type="text" name="year" placeholder="السنة" value="<%= filters.year || '' %>">
    <button class="panel-btn panel-btn-secondary" type="submit">تصفية</button>
  </form>
</div>
<div class="panel-table">
  <table>
    <thead>
      <tr>
        <th>الاسم</th>
        <th>التخصص</th>
        <th>السنة</th>
        <th>السعر</th>
        <th>المدرس</th>
        <th>نسبة المدرس</th>
        <th>المشتريات</th>
        <th>الحالة</th>
        <th>إجراءات</th>
      </tr>
    </thead>
    <tbody>
      <% if (!courses.length) { %>
        <tr>
          <td colspan="9">
            <section class="polish-empty">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 5h16v14H4V5zm2 2v10h12V7H6zm2 2h8v2H8V9z"/></svg>
              <h4>لا توجد كورسات مطابقة للفلاتر الحالية</h4>
              <p>غيّر معايير التصفية لإظهار نتائج أخرى.</p>
            </section>
          </td>
        </tr>
      <% } %>
      <% courses.forEach((item) => { %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.specialization_name %></td>
          <td><%= item.year %></td>
          <td><%= money(item.price) %></td>
          <td><%= item.teacher_full_name || '-' %></td>
          <td><%= item.teacher_percent %>%</td>
          <td><%= item.purchases_count || 0 %></td>
          <td><%= item.is_published ? 'منشور' : 'مخفي' %></td>
          <td>
            <button class="panel-btn panel-btn-secondary" data-modal-open="course-edit-modal" data-modal-action="/panel/admin/courses/<%= item.id %>" data-modal-fill='<%= JSON.stringify(item) %>'>تعديل</button>
            <form method="post" action="/panel/admin/courses/<%= item.id %>/toggle" style="display:inline;">
              <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
              <input type="hidden" name="next_is_published" value="<%= item.is_published ? 'false' : 'true' %>">
              <button class="panel-btn panel-btn-secondary" type="submit" data-confirm="هل تريد <%= item.is_published ? 'إخفاء' : 'نشر' %> هذا الكورس؟"><%= item.is_published ? 'إخفاء' : 'نشر' %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<div class="panel-modal" id="course-create-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>إضافة كورس</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/courses" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>التخصص</label>
          <select name="specialization_id" required>
            <option value="">اختر التخصص</option>
            <% specializations.forEach((item) => { %>
              <option value="<%= item.id %>"><%= item.name %></option>
            <% }) %>
          </select>
        </div>
        <div><label>المدرس</label>
          <select name="teacher_id">
            <option value="">بدون مدرس</option>
            <% teachers.forEach((item) => { %>
              <option value="<%= item.teacher_id %>"><%= item.full_name || item.username %></option>
            <% }) %>
          </select>
        </div>
        <div><label>النسبة</label><input name="teacher_percent" type="text" value="0.00"></div>
        <div><label>السنة</label><input name="year" type="number" min="1" max="5" required></div>
        <div><label>الاسم</label><input name="name" required></div>
        <div><label>السعر</label><input name="price" type="text" value="0.00" required></div>
        <div><label>الوصف</label><textarea name="description"></textarea></div>
        <div><label>الترتيب</label><input name="sort_order" type="number" min="0" value="0"></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<div class="panel-modal" id="course-edit-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>تعديل كورس</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/courses/0" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <p class="panel-muted" id="course-reassignment-warning" style="margin:0 0 12px;display:none;"></p>
      <div class="panel-form-grid">
        <div><label>التخصص</label>
          <select name="specialization_id" data-fill="specialization_id">
            <option value="">اختر التخصص</option>
            <% specializations.forEach((item) => { %>
              <option value="<%= item.id %>"><%= item.name %></option>
            <% }) %>
          </select>
        </div>
        <div><label>المدرس</label>
          <select name="teacher_id" data-fill="teacher_id">
            <option value="">بدون مدرس</option>
            <% teachers.forEach((item) => { %>
              <option value="<%= item.teacher_id %>"><%= item.full_name || item.username %></option>
            <% }) %>
          </select>
        </div>
        <div><label>النسبة</label><input name="teacher_percent" type="text" data-fill="teacher_percent"></div>
        <div><label>السنة</label><input name="year" type="number" min="1" max="5" data-fill="year"></div>
        <div><label>الاسم</label><input name="name" data-fill="name"></div>
        <div><label>السعر</label><input name="price" type="text" data-fill="price"></div>
        <div><label>الوصف</label><textarea name="description" data-fill="description"></textarea></div>
        <div><label>الترتيب</label><input name="sort_order" type="number" min="0" data-fill="sort_order"></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ التغييرات</button></div>
    </form>
  </div>
</div>
<script>
  (() => {
    const warning = document.getElementById('course-reassignment-warning');
    if (!warning) {
      return;
    }

    const formatMoney = (value) => {
      const num = Number(value ?? 0);
      if (!Number.isFinite(num)) {
        return '0.00';
      }
      return num.toFixed(2);
    };

    document.querySelectorAll('[data-modal-open="course-edit-modal"]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const raw = trigger.getAttribute('data-modal-fill');
        if (!raw) {
          warning.style.display = 'none';
          warning.textContent = '';
          return;
        }

        try {
          const item = JSON.parse(raw);
          const teacherName = item.teacher_full_name || 'بدون اسم';
          const purchasesCount = Number(item.current_teacher_historical_purchases_count ?? 0);
          const earned = formatMoney(item.current_teacher_historical_earned ?? '0.00');

          if (!item.teacher_id) {
            warning.style.display = 'none';
            warning.textContent = '';
            return;
          }

          warning.textContent = `تنبيه: سيحتفظ الأستاذ الحالي (${teacherName}) بأرباحه من ${purchasesCount} عملية شراء سابقة بقيمة ${earned}.`;
          warning.style.display = 'block';
        } catch (_error) {
          warning.style.display = 'none';
          warning.textContent = '';
        }
      });
    });
  })();
</script>
<%- include('../layout/footer') %>
