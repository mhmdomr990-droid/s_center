<%- include('../layout/header', { title: 'نظرة عامة' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken, pendingTopupsCount }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar">
  <div>
    <h1 style="margin:0;">نظرة عامة</h1>
    <p class="panel-muted" style="margin:6px 0 0;">إحصاءات المبيعات والشحن والطلاب والمدرسين</p>
  </div>
  <div class="panel-tabs">
    <a class="panel-tab <%= days === 7 ? 'active' : '' %>" href="/panel/admin/overview?days=7">7 أيام</a>
    <a class="panel-tab <%= days === 30 ? 'active' : '' %>" href="/panel/admin/overview?days=30">30 يوم</a>
    <a class="panel-tab <%= days === 90 ? 'active' : '' %>" href="/panel/admin/overview?days=90">90 يوم</a>
  </div>
</div>
<div class="panel-cards">
  <% statCards.forEach((card) => { %>
    <div class="panel-card panel-stat">
      <span><%= card.label %></span>
      <strong><%= card.value %></strong>
    </div>
  <% }) %>
</div>
<div class="panel-grid-2">
  <div class="panel-card">
    <h3 style="margin-top:0;">المبيعات اليومية</h3>
    <div class="panel-chart-wrap">
      <canvas class="panel-chart" data-chart="line" data-chart-data='<%= JSON.stringify(salesChart) %>'></canvas>
    </div>
  </div>
  <div class="panel-card">
    <h3 style="margin-top:0;">أعلى الكورسات</h3>
    <div class="panel-chart-wrap">
      <canvas class="panel-chart" data-chart="bar" data-chart-data='<%= JSON.stringify(topCoursesChart) %>'></canvas>
    </div>
  </div>
</div>
<div class="panel-card" style="margin-top:16px;">
  <h3 style="margin-top:0;">المبيعات حسب التخصص</h3>
  <div class="panel-table">
    <table>
      <thead>
        <tr>
          <th>التخصص</th>
          <th>عدد المشتريات</th>
          <th>الإيراد</th>
        </tr>
      </thead>
      <tbody>
        <% if (!specializationSales.length) { %>
          <tr>
            <td colspan="3">
              <section class="polish-empty">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 5h16v14H4V5zm2 2v10h12V7H6z"/></svg>
                <h4>لا تتوفر بيانات مبيعات ضمن هذه الفترة</h4>
                <p>اختر فترة أوسع أو انتظر تسجيل عمليات شراء جديدة.</p>
              </section>
            </td>
          </tr>
        <% } %>
        <% specializationSales.forEach((row) => { %>
          <tr>
            <td><%= row.name %></td>
            <td><%= row.purchases_count %></td>
            <td><%= money(row.revenue) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../layout/footer') %>
