<%- include('../layout/header', { title: 'المدرسون' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken, pendingTopupsCount }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar">
  <div><h1 style="margin:0;">المدرسون</h1></div>
  <button class="panel-btn panel-btn-primary" data-modal-open="teacher-create-modal">إضافة مدرس</button>
</div>
<%- include('../partials/breadcrumb', {
  items: [
    { label: 'لوحة التحكم', href: '/panel/admin/overview' },
    { label: 'المعلّمون' },
  ],
}) %>
<div class="panel-table">
  <table>
    <thead>
      <tr>
        <th>الاسم</th>
        <th>المشتريات</th>
        <th>المستحق</th>
        <th>المدفوع</th>
        <th>المتبقي</th>
        <th>إجراءات</th>
      </tr>
    </thead>
    <tbody>
      <% if (!teachers.length) { %>
        <tr>
          <td colspan="6">
            <section class="polish-empty">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3l10 5-10 5L2 8l10-5zm-6 8.7V16c0 2.2 2.7 4 6 4s6-1.8 6-4v-4.3l-6 3-6-3z"/></svg>
              <h4>لا يوجد مدرسون بعد</h4>
              <p>يمكنك إضافة حساب مدرس جديد من الزر العلوي.</p>
            </section>
          </td>
        </tr>
      <% } %>
      <% teachers.forEach((item) => { %>
        <tr>
          <td><%= item.full_name %> (<%= item.username %>)</td>
          <td><%= item.purchases_count %></td>
          <td><%= money(item.earned) %></td>
          <td><%= money(item.paid) %></td>
          <td><%= money(item.remaining) %></td>
          <td>
            <a class="panel-btn panel-btn-secondary" href="/panel/admin/teachers/<%= item.teacher_id %>/payouts">سجل الدفعات</a>
            <button class="panel-btn panel-btn-primary" data-modal-open="teacher-payout-modal" data-modal-action="/panel/admin/teachers/<%= item.teacher_id %>/payouts" data-modal-fill='<%= JSON.stringify(item) %>'>إضافة دفعة</button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<div class="panel-modal" id="teacher-create-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>إضافة مدرس</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/teachers" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>اسم المستخدم</label><input name="username" required></div>
        <div><label>الاسم الكامل</label><input name="full_name" required></div>
        <div><label>كلمة المرور</label><input name="password" type="password" required></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<div class="panel-modal" id="teacher-payout-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>إضافة دفعة للمدرس</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/teachers/0/payouts" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>المبلغ</label><input name="amount" type="text" required></div>
        <div><label>ملاحظة</label><input name="note" type="text"></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<%- include('../layout/footer') %>
