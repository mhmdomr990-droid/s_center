<%- include('../layout/header', { title: 'المستخدمون' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken, pendingTopupsCount }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar">
  <div>
    <h1 style="margin:0;">المستخدمون</h1>
  </div>
  <div class="panel-topbar-actions">
    <button class="panel-btn panel-btn-primary" data-modal-open="student-create-modal">إضافة طالب</button>
    <button class="panel-btn panel-btn-secondary" data-modal-open="admin-create-modal">إضافة مدير</button>
    <form method="get" action="/panel/admin/users" class="panel-topbar-search">
      <input type="text" name="search" placeholder="بحث" value="<%= search || '' %>">
      <button class="panel-btn panel-btn-secondary" type="submit">بحث</button>
    </form>
  </div>
</div>
<%- include('../partials/breadcrumb', {
  items: [
    { label: 'لوحة التحكم', href: '/panel/admin/overview' },
    { label: 'المستخدمون' },
  ],
}) %>
<div class="panel-table">
  <table>
    <thead>
      <tr>
        <th>اسم المستخدم</th>
        <th>الاسم الكامل</th>
        <th>الهاتف</th>
        <th>التخصص</th>
        <th>الدور</th>
        <th>الحالة</th>
        <th>الرصيد</th>
        <th>إجراءات</th>
      </tr>
    </thead>
    <tbody>
      <% if (!users.length) { %>
        <tr>
          <td colspan="8">
            <section class="polish-empty">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10 4a4 4 0 100 8 4 4 0 000-8zm8 2h-2v2h2V6zm-2 6h2v2h-2v-2zM4 18c0-2.2 3-4 6-4s6 1.8 6 4v2H4v-2z"/></svg>
              <h4>لا توجد نتائج مطابقة</h4>
              <p>عدّل كلمات البحث أو امسح الفلاتر لإظهار المستخدمين.</p>
            </section>
          </td>
        </tr>
      <% } %>
      <% users.forEach((item) => { %>
        <tr>
          <td><%= item.username %></td>
          <td><%= item.full_name %></td>
          <td><%= item.phone || '-' %></td>
          <td><%= item.specialization_name || 'غير محدد' %></td>
          <td><%= item.role %></td>
          <td><%= item.is_active ? 'نشط' : 'موقوف' %></td>
          <td><%= money(item.balance) %></td>
          <td>
            <details class="panel-actions-dropdown" style="position:relative;display:inline-block;">
              <summary class="panel-btn panel-btn-secondary" style="list-style:none;cursor:pointer;">الإجراءات</summary>
              <div style="position:absolute;left:0;top:calc(100% + 6px);background:#fff;border:1px solid #ded7ca;border-radius:10px;box-shadow:0 6px 18px rgba(0,0,0,.08);padding:8px;min-width:220px;z-index:30;">
                <form method="post" action="/panel/admin/users/<%= item.id %>/active" style="display:block;margin-bottom:6px;">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <input type="hidden" name="is_active" value="<%= item.is_active ? 'false' : 'true' %>">
                  <button class="panel-btn panel-btn-secondary" style="width:100%;" type="submit"><%= item.is_active ? 'إيقاف الحساب' : 'تفعيل الحساب' %></button>
                </form>
                <form method="post" action="/panel/admin/users/<%= item.id %>/reset-device" style="display:block;margin-bottom:6px;">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <button class="panel-btn panel-btn-secondary" style="width:100%;" type="submit" data-confirm="هل تريد تصفير الجهاز لهذا المستخدم؟">إعادة ضبط الجهاز</button>
                </form>
                <button class="panel-btn panel-btn-secondary" style="width:100%;margin-bottom:6px;" data-modal-open="user-grant-course-modal-<%= item.id %>">منح كورس مجاني</button>
                <button class="panel-btn panel-btn-secondary" style="width:100%;margin-bottom:6px;" data-modal-open="user-reset-password-modal" data-modal-action="/panel/admin/users/<%= item.id %>/reset-password" data-modal-fill='<%= JSON.stringify(item) %>'>إعادة تعيين كلمة المرور</button>
                <button class="panel-btn panel-btn-secondary" style="width:100%;" data-modal-open="user-adjust-balance-modal" data-modal-action="/panel/admin/users/<%= item.id %>/adjust-balance" data-modal-fill='<%= JSON.stringify(item) %>'>تعديل الرصيد</button>
              </div>
            </details>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% users.forEach((item) => { %>
  <% const specializationCourses = item.specialization_id
    ? courses.filter((course) => Number(course.specialization_id) === Number(item.specialization_id))
    : []; %>
  <div class="panel-modal" id="user-grant-course-modal-<%= item.id %>">
    <div class="panel-modal-content">
      <div class="panel-modal-header"><h3>منح كورس مجاني - <%= item.full_name %></h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
      <form method="post" action="/panel/admin/users/<%= item.id %>/grant-course" class="panel-form">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <div class="panel-form-grid">
          <div>
            <label>الكورس</label>
            <% if (specializationCourses.length) { %>
              <select name="course_id" required>
                <% specializationCourses.forEach((course) => { %>
                  <option value="<%= course.id %>"><%= course.name %> - <%= course.year %> / <%= course.specialization_name || 'غير محدد' %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input type="text" value="لا توجد كورسات متاحة ضمن اختصاص هذا الطالب" disabled>
            <% } %>
          </div>
        </div>
        <div class="panel-form-actions">
          <button class="panel-btn panel-btn-primary" type="submit" <%= specializationCourses.length ? '' : 'disabled' %>>حفظ المنحة</button>
        </div>
      </form>
    </div>
  </div>
<% }) %>
<div class="panel-section" style="margin-top:24px;">
  <div class="panel-section-header" style="margin-bottom:12px;">
    <h2 style="margin:0;">الطلاب الذين حصلوا على منح مجانية مني</h2>
  </div>
  <% if (!freeGrants.length) { %>
    <div class="polish-empty" style="padding:20px;">
      <p>لا توجد منحة مجانية مسجلة لك حتى الآن.</p>
    </div>
  <% } else { %>
    <div class="panel-table">
      <table>
        <thead>
          <tr>
            <th>اسم المستخدم</th>
            <th>الاسم الكامل</th>
            <th>الكورس</th>
            <th>التخصص</th>
            <th>تاريخ المنحة</th>
            <th>إجراء</th>
          </tr>
        </thead>
        <tbody>
          <% freeGrants.forEach((grant) => { %>
            <tr>
              <td><%= grant.username %></td>
              <td><%= grant.full_name %></td>
              <td><%= grant.course_name %></td>
              <td><%= grant.specialization_name %></td>
              <td><%= date(grant.granted_at) %></td>
              <td>
                <form method="post" action="/panel/admin/users/<%= grant.user_id %>/revoke-course-grant" style="display:inline;">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <input type="hidden" name="course_id" value="<%= grant.course_id %>">
                  <button class="panel-btn panel-btn-secondary" type="submit" data-confirm="هل تريد إلغاء هذه المنحة المجانية؟">إلغاء المنحة</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<div class="panel-modal" id="student-create-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>إضافة طالب جديد</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/students" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>اسم المستخدم</label><input name="username" required></div>
        <div><label>الاسم الكامل</label><input name="full_name" required></div>
        <div><label>كلمة المرور</label><input name="password" type="password" required></div>
        <div><label>الهاتف (اختياري)</label><input name="phone" type="tel" placeholder="05xxxxxxxx"></div>
        <div>
          <label>التخصص (اختياري)</label>
          <select name="specialization_id">
            <option value="">بدون تخصص</option>
            <% specializations.forEach((spec) => { %>
              <option value="<%= spec.id %>"><%= spec.name %></option>
            <% }) %>
          </select>
        </div>
        <div><label>معرّف الجهاز (اختياري)</label><input name="device_id" type="text" placeholder="إذا كان الجهاز معروفًا"></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<div class="panel-modal" id="admin-create-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>إضافة مدير جديد</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/admins" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>اسم المستخدم</label><input name="username" required></div>
        <div><label>الاسم الكامل</label><input name="full_name" required></div>
        <div><label>كلمة المرور</label><input name="password" type="password" required></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<div class="panel-modal" id="user-reset-password-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>إعادة تعيين كلمة المرور</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/users/0/reset-password" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div>
          <label>كلمة المرور الجديدة</label>
          <div class="panel-toolbar" style="margin:0;">
            <input id="resetPasswordField" name="new_password" type="password" required>
            <button type="button" class="polish-copy-btn" data-copy-target="#resetPasswordField" data-copy-success="تم نسخ كلمة المرور">نسخ</button>
          </div>
        </div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<div class="panel-modal" id="user-adjust-balance-modal">
  <div class="panel-modal-content">
    <div class="panel-modal-header"><h3>تعديل الرصيد</h3><button type="button" class="panel-modal-close" data-modal-close>×</button></div>
    <form method="post" action="/panel/admin/users/0/adjust-balance" class="panel-form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="panel-form-grid">
        <div><label>المبلغ</label><input name="amount" type="text" required></div>
        <div><label>الوصف</label><input name="description" type="text" required></div>
      </div>
      <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">حفظ</button></div>
    </form>
  </div>
</div>
<%- include('../layout/footer') %>
