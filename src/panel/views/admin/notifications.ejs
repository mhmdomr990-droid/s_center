<%- include('../layout/header', { title: 'الإشعارات' }) %>
<%- include('../layout/sidebar', { currentUser, csrfToken, pendingTopupsCount }) %>
<%- include('../partials/flash', { flash }) %>
<div class="panel-topbar"><h1 style="margin:0;">الإشعارات</h1></div>
<%- include('../partials/breadcrumb', {
  items: [
    { label: 'لوحة التحكم', href: '/panel/admin/overview' },
    { label: 'الإشعارات' },
  ],
}) %>
<div class="panel-card">
  <form method="post" action="/panel/admin/notifications" class="panel-form">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <div class="panel-form-grid">
      <div><label>إلى الجميع</label><input type="checkbox" name="all" value="true"></div>
      <div><label>اسم المستخدم</label><input name="username" placeholder="اختياري"></div>
      <div><label>العنوان</label><input name="title" required></div>
      <div><label>النص</label><textarea name="body" required></textarea></div>
    </div>
    <div class="panel-form-actions"><button class="panel-btn panel-btn-primary" type="submit">إرسال</button></div>
  </form>
</div>
<%- include('../layout/footer') %>
