NODE_ENV=development
PORT=3000

# Reverse proxy trust (set to 1 behind single nginx proxy in production).
# nginx must forward real client IP headers:
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=student_bot
DB_SYNC=false
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
STAFF_JWT_EXPIRES_IN=14d
CORS_ORIGINS=http://localhost:3000
VIDEO_STORAGE_PATH=storage/videos
VIDEO_MAX_SIZE_MB=2048
VIDEO_SIGNING_SECRET=replace_with_a_long_random_video_secret
DOWNLOAD_URL_EXPIRY_MINUTES=120
DOWNLOAD_TTL_DAYS=90
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Rate limiting
RATE_LIMIT_GENERAL_WINDOW_MINUTES=15
RATE_LIMIT_GENERAL_MAX=600
RATE_LIMIT_GENERAL_STAFF_MAX=3000
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MINUTES=15
RATE_LIMIT_SENSITIVE_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_MINUTES=60
RATE_LIMIT_UPLOAD_MAX=60
